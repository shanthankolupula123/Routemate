{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "buildCommand": "node prepare-www.js",
  "outputDirectory": "www",
  "rewrites": [
    { "source": "/api/ride-requests/:match*", "destination": "/api/ride-requests" },
    { "source": "/api/kyc/:match*", "destination": "/api/kyc" },
    { "source": "/api/feedbacks/:match*", "destination": "/api/feedbacks" }
  ],
  "headers": [
    {
      "source": "/api/:match*",
      "headers": [
        { "key": "Access-Control-Allow-Credentials", "value": "true" },
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Access-Control-Allow-Methods", "value": "GET,OPTIONS,PATCH,DELETE,POST,PUT" },
        { "key": "Access-Control-Allow-Headers", "value": "X-CSRF-Token, X-Requested-With, Accept, Accept-Version, Content-Length, Content-MD5, Content-Type, Date, X-Api-Version, Authorization, apikey" }
      ]
    },
    {
      "source": "/:match*",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" },
        { "key": "Pragma", "value": "no-cache" }
      ]
    }
  ]
}
